# Copy to .env and adjust. Only SECRET_KEY must be changed.

# Signs login tokens and file links. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

POSTGRES_PASSWORD=voicely

# Where the site is published. Keep 127.0.0.1 unless you mean to expose it.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Set to false once your accounts exist, to stop new sign-ups.
ALLOW_REGISTRATION=true

# Per-job limits.
MAX_AUDIO_MINUTES=10
MAX_UPLOAD_MB=200

# cpu or cuda. Use docker-compose.gpu.yml rather than setting cuda here.
ENGINE_DEVICE=cpu

# Queues the worker serves. "fast" = conversions, "train" = training.
WORKER_QUEUES=fast,train
# Voice models kept loaded in memory (each costs RAM).
VOICE_CACHE_SIZE=2
# 1 = cleaner vocal separation at twice the time.
MDX_DENOISE=0
